# Netlify / Cloudflare Pages cache headers. Ignored by other hosts — see
# .htaccess (Apache) and vercel.json (Vercel) for the equivalent rules.

/*.css
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable

/assets/img/*
  Cache-Control: public, max-age=31536000

/assets/*.svg
  Cache-Control: public, max-age=31536000

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate
